    {
      "id": "condt",
      "type": "text",
      "x": 370,
      "y": 150,
      "width": 290,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
