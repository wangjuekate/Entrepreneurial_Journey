      "link": null,
      "locked": false,
      "customData": {
        "beat": 3
      },
      "text": "Not the CEO. Senior enough to\nallocate people, junior enough to be\nmeasured on this quarter \u2014 so the\nventure's only advocate is also the\nperson who pays for it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Not the CEO. Senior enough to\nallocate people, junior enough to be\nmeasured on this quarter \u2014 so the\nventure's only advocate is also the\nperson who pays for it.",
      "lineHeight": 1.25,
      "baseline": 14
    },
